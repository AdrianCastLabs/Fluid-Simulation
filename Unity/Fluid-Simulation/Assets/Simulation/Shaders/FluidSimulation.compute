#pragma kernel ComputeDensity
#pragma kernel ComputePressureForce
#pragma kernel Integrate
#pragma kernel HandleCollisions

struct Particle
{
    float3 position;
    float3 velocity;
    float3 force;
    float density;
};

RWStructuredBuffer<Particle> particles;

int nParticles;
float smoothingRadius;
float mass;
float targetDensity;
float pressureMultiplier;
float timeStep;
float gravity;
vector simulationSize;
float particleRadius;
float damping;

float SmoothingKernel(float radius, float distance)
{
    if (distance >= radius) return 0;
    
    float volume = (3.14159265359 * pow(radius, 4)) / 6.0;
    return (radius - distance) * (radius - distance) / volume;
}

float SmoothingKernelDerivative(float radius, float distance)
{
    if (distance >= radius) return 0;
    
    float scale = 12.0 / (pow(radius, 4) * 3.14159265359 );
    return (distance - radius) * scale;
}

float ConvertDensityToPressure(float density)
{
    return (density - targetDensity) * pressureMultiplier;
}

[numthreads(64, 1, 1)]
void ComputeDensity(uint id : SV_DispatchThreadID)
{
    if (id.x >= (uint)nParticles) return;
    int i = id.x;
    
    Particle particle = particles[i];
    
    float density = 0;
    float3 samplePoint = particle.position;
    
    for (int j = 0; j < nParticles; j++)
    {
        float distance = length(particles[j].position - samplePoint);
        float influence = SmoothingKernel(smoothingRadius, distance);
        density += mass * influence;
    }
    particle.density = density;
    particles[i] = particle;
}

[numthreads(64, 1, 1)]
void ComputePressureForce(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)nParticles) return;
    int i = id.x;
    
    Particle particle = particles[i];
    
    float3 pressureForce = float3(0, 0, 0);
    
    for (int j = 0; j < nParticles; j++)
    {
        if (i == (uint)j) continue;
        Particle otherParticle = particles[j];
        
        float3 offset = otherParticle.position - particle.position;
        float distance = length(offset);
        
        if (distance < 0.0001) continue;
        
        float3 direction = offset / distance;
        float slope = SmoothingKernelDerivative(smoothingRadius, distance);
        
        float pressureA = ConvertDensityToPressure(otherParticle.density);
        float pressureB = ConvertDensityToPressure(particle.density);
        float SharedPressure = (pressureA + pressureB) / 2.0;
        
        pressureForce += SharedPressure * direction * slope * mass / otherParticle.density;
    }
    particle.force = pressureForce;
    particles[i] = particle;
}

[numthreads(64, 1, 1)]
void Integrate(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)nParticles) return;
    int i = id.x;
    
    Particle particle = particles[i];
    
    // Apply pressure and acceleration
    float density = max(particle.density, 0.0001);
    float3 acceleration = particle.force / density;
    particle.velocity += acceleration * timeStep;
    
    // Apply gravity and damping
    particle.velocity *= 0.999;
    particle.velocity.y -= gravity * timeStep;
    
    // Update position
    particle.position += particle.velocity * timeStep;
    
    // Boundary conditions
    if (particle.position.x <= 0.0 || particle.position.x >= simulationSize.x)
    {
        particle.velocity.x *= -damping;
        particle.position.x = clamp(particle.position.x, 0.0, simulationSize.x);
    }
    
    if (particle.position.y <= 0.0 || particle.position.y >= simulationSize.y)
    {
        particle.velocity.y *= -damping;
        particle.position.y = clamp(particle.position.y, 0.0, simulationSize.y);
    }
    
    particles[i] = particle;
}


[numthreads(64, 1, 1)]
void HandleCollisions(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)nParticles) return;
    
    float minDistance = particleRadius * 2.0;
    float restitution = 0.2;
    
    float3 positionDelta = float3(0, 0, 0);
    float3 velocityDelta = float3(0, 0, 0);
    
    for (uint j = 0; j < (uint)nParticles; j++)
    {
        if (id.x == j) continue;
        
        float3 delta = particles[j].position - particles[id.x].position;
        float distSquared = dot(delta, delta);
        float minDistSquared = minDistance * minDistance;
        
        if (distSquared < minDistSquared && distSquared > 0.0001)
        {
            float distance = sqrt(distSquared);
            float3 normal = delta / distance;
            
            // Accumulate position correction
            float overlap = minDistance - distance;
            positionDelta -= normal * overlap * 0.5;
            
            // Accumulate velocity correction
            float3 relativeVelocity = particles[id.x].velocity - particles[j].velocity;
            float velAlongNormal = dot(relativeVelocity, normal);
            
            if (velAlongNormal > 0)
            {
                float impulseMagnitude = -(1.0 + restitution) * velAlongNormal * 0.5;
                velocityDelta += normal * impulseMagnitude;
            }
        }
    }
    
    // Apply accumulated changes
    particles[id.x].position += positionDelta;
    particles[id.x].velocity += velocityDelta;
}